# Azure OpenAI — used by ex1, ex2, ex5, ex6, ex7
ENDPOINT_URL=https://<your-resource>.openai.azure.com/openai/v1
DEPLOYMENT_NAME=<your-chat-deployment-name>
AZURE_OPENAI_API_KEY=<your-api-key>

# Azure Embeddings — used by ex4
EMBEDDING_ENDPOINT_URL=https://<your-resource>.openai.azure.com/
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
EMBEDDING_API_VERSION=2023-05-15

# Local LLM (LM Studio) — used by ex0, optional (defaults shown)
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=liquid/lfm2.5-1.2b
