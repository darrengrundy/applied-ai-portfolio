# Azure OpenAI endpoint -- include the /openai/v1/ path suffix
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/openai/v1/

# Deployment name (shown in Azure AI Foundry -> Deployments)
MODEL_DEPLOYMENT=your-model-deployment-name

# API key (optional).
# When set, this key is used instead of DefaultAzureCredential / az login.
# When absent, the application uses DefaultAzureCredential (requires az login
# or a managed identity with access to the Foundry resource).
# AZURE_OPENAI_API_KEY=your-api-key
